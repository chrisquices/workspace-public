{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/vue-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5.12",
        "aws/aws-sdk-php": "^3.404",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.95",
        "larastan/larastan": "^3.13",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nesbot/carbon": "^3.15",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel --config=../../shared/tooling/pint/pint.json"
        ],
        "lint:check": [
            "pint --test --config=../../shared/tooling/pint/pint.json",
            "php-cs-fixer fix --config=../../shared/tooling/php-cs-fixer/php-cs-fixer.php --dry-run --diff"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@quality:check",
            "@test"
        ],
        "types:check": "phpstan analyse --configuration=../../shared/tooling/phpstan/laravel.neon",
        "test": "pest",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "architecture:check": "deptrac analyse --config-file=../../shared/tooling/deptrac/deptrac.php",
        "lint:fix": [
            "pint --config=../../shared/tooling/pint/pint.json",
            "php-cs-fixer fix --config=../../shared/tooling/php-cs-fixer/php-cs-fixer.php"
        ],
        "refactor:check": "rector process --dry-run --config=../../shared/tooling/rector/rector.php",
        "refactor:fix": "rector process --config=../../shared/tooling/rector/rector.php",
        "quality:check": [
            "@lint:check",
            "@types:check",
            "@refactor:check",
            "@architecture:check",
            "npm run quality:check"
        ],
        "quality:fix": [
            "@refactor:fix",
            "@lint:fix",
            "@types:check",
            "@architecture:check",
            "npm run quality:fix"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
