# Dependencies at any depth, including apps and shared packages
node_modules/
vendor/

# Local environment and credentials; keep example files
.env
.env.*
!.env.example
!.env.*.example
/auth.json
/apps/*/auth.json
/shared/**/auth.json

# JavaScript build output and caches
dist/
dist-ssr/
.vite/
.vite-temp/
.next/
.nuxt/
.output/
.turbo/
.parcel-cache/
.eslintcache
*.tsbuildinfo
/apps/*/build/
/apps/escode/capsule/build/

# Logs and analysis output
*.log
coverage/
.nyc_output/
.phpunit.cache/
.phpunit.result.cache
.php-cs-fixer.cache
.phpstan.cache
.deptrac.cache

# Laravel generated assets and runtime files
/apps/*/bootstrap/ssr/
/apps/*/bootstrap/cache/*
!/apps/*/bootstrap/cache/.gitignore
/apps/*/public/build/
/apps/*/public/hot
/apps/*/public/storage
/apps/*/public/fonts-manifest*.json
/apps/*/storage/**
!/apps/*/storage/**/
!/apps/*/storage/**/.gitignore
/apps/*/database/*.sqlite*
/apps/*/resources/js/actions/
/apps/*/resources/js/routes/
/apps/*/resources/js/wayfinder/
/apps/*/_ide_helper.php
/apps/*/_ide_helper_actions.php
/apps/*/_ide_helper_models.php
/apps/*/.phpstorm.meta.php
.phpactor.json
Homestead.json
Homestead.yaml

# NativePHP and IDE-plugin generated output
/apps/*/nativephp/electron/out/
/apps/strata-ide-plugin/jetbrains/build/
.gradle/
.intellijPlatform/

# Editor and operating-system files
.idea/
.fleet/
.nova/
.vscode/
.zed/
*.iml
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Escode starter rules (scoped to this project)
/apps/escode/**/logs
/apps/escode/**/*.log
/apps/escode/**/npm-debug.log*
/apps/escode/**/yarn-debug.log*
/apps/escode/**/yarn-error.log*
/apps/escode/**/pnpm-debug.log*
/apps/escode/**/lerna-debug.log*
/apps/escode/**/node_modules
/apps/escode/**/.DS_Store
/apps/escode/**/dist
/apps/escode/**/dist-ssr
/apps/escode/**/coverage
/apps/escode/**/*.local
/apps/escode/.vscode/*
!/apps/escode/.vscode/extensions.json
/apps/escode/**/.idea
/apps/escode/**/*.suo
/apps/escode/**/*.ntvs*
/apps/escode/**/*.njsproj
/apps/escode/**/*.sln
/apps/escode/**/*.sw?
/apps/escode/**/*.tsbuildinfo
/apps/escode/**/.eslintcache
/apps/escode/cypress/videos/
/apps/escode/cypress/screenshots/
/apps/escode/**/__screenshots__/
/apps/escode/**/*.timestamp-*-*.mjs
